# ============================================================================
# CONFIG MAP (same header in all 5 config files, so any one orients you):
#   .env.example                -> YOU ARE HERE: copy to backend/.env (gitignored)
#                                   to feed docker-compose.yml. Spring Boot never
#                                   reads this file directly.
#   docker-compose.yml          -> reads the .env this file becomes
#   Dockerfile                  -> what docker-compose's backend service (and
#                                   Render) builds from
#   application.properties      -> base+dev config, read when you run `mvnw`
#                                   instead of the full-stack profile below
#   application-prod.properties -> prod config, read by the containerized
#                                   backend (full-stack profile) or Render
# ============================================================================
#
# DEFAULT local dev needs no .env at all:
#   docker-compose up -d          -> starts db + adminer + keycloak only
#   mvnw spring-boot:run          -> runs the app on the `dev` profile, using
#                                     application.properties defaults (base +
#                                     the dev-profile section in that same
#                                     file), which already match the
#                                     containers above
#
# This file only matters for the OPT-IN full-stack mode, where the backend
# itself also runs in a container (`prod` profile below):
#   copy this file to backend/.env, then:
#   docker-compose --profile full-stack up -d
#
# A real Render deployment reads none of this — those values are set directly
# in the Render dashboard, against application-prod.properties.

# ---------- Runtime profile (full-stack container mode only) ----------
SPRING_PROFILES_ACTIVE=prod
APP_TIMEZONE=Asia/Kolkata

# ---------- Backend host port ----------
# Use 8080 locally: the Vite dev server proxies /api to http://localhost:8080
# (frontend/vite.config.ts), so any other value silently breaks every API call
# from the frontend while the container itself looks perfectly healthy.
# EC2/API Gateway option: 80
BACKEND_HOST_PORT=8080

# ---------- Database ----------
DATABASE_URL=jdbc:postgresql://db:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changemeinprod!
DB_HOST_PORT=5433
# The local db container does not support SSL, but application-prod.properties
# defaults to sslmode=require for Render. Needed only for the full-stack
# rehearsal below. NEVER set this in Render.
DATABASE_SSLMODE=disable

# ---------- Auth0 (the live IDP) ----------
# From the Auth0 dashboard. AUTH0_DOMAIN drives both the issuer URI and the
# Management API base URL, so it is the one that must always be set.
# No scheme, no trailing slash - the app builds https://${AUTH0_DOMAIN}/ itself.
# NOTE: Spring does not read this file (no dotenv dependency); only
# docker-compose does. For `mvnw spring-boot:run`, export these instead.
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Must match the Identifier of the API registered in Auth0, and
# VITE_OIDC_AUDIENCE in the frontend.
AUTH0_AUDIENCE=https://api.venuesync.app
# Machine-to-Machine app, used only by the ATTENDEE -> ORGANIZER role bridge.
# Scopes: read:users, read:roles, create:role_members. Never expose to a browser.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ---------- Adminer ----------
ADMINER_HOST_PORT=8888

# ---------- CORS ----------
# Comma-separated. Add your current Cloudflare preview URL if testing preview deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://venuesync.pages.dev,https://aeea1436.venuesync.pages.dev

# ##### EVERYTHING BELOW IS LEGACY KEYCLOAK - UNUSED BY THE BACKEND #####
# ---------- Keycloak (legacy reference artifact) ----------
# No longer used by the backend - the Java classes and properties that read
# these are commented out, not deleted. See keycloak/README.md for why the
# self-hosted setup was retired (Render free-tier instance hours) and how to
# bring it back. docker-compose still starts the container; it is simply unused.
KEYCLOAK_HOST_PORT=9090
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Public URL where browser and OIDC clients reach Keycloak.
# Local example: http://localhost:9090
# Tunnel/prod example: https://your-tunnel.trycloudflare.com
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:9090
# Keycloak hostname/proxy settings so OIDC metadata advertises the same public URL.
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=false
# Backend token issuer validation URL. Keep this aligned with KEYCLOAK_PUBLIC_BASE_URL.
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/event-ticket-platform

