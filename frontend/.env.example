# ============================================================================
# CONFIG MAP (frontend):
#   .env.example      -> YOU ARE HERE: copy to frontend/.env for local dev
#                         (.env is gitignored). Vite reads .env in every mode.
#   Cloudflare Pages  -> holds the production values (Settings -> Environment
#                         variables); they are baked into the bundle at build time
#   vite.config.ts    -> dev server proxies /api/* to http://localhost:8080,
#                         which is why VITE_API_BASE_URL is empty in dev
# NOTE: every VITE_* value is compiled into the JavaScript bundle and is
# readable by anyone who opens devtools. NOTHING SECRET GOES IN HERE.
# The backend's AUTH0_M2M_CLIENT_SECRET must never appear in this file or any
# other frontend file - it would hand every visitor the ability to grant
# themselves ROLE_ORGANIZER.
# ============================================================================

# ---------- Auth0 (public by design) ----------
# Your Auth0 tenant. No trailing slash here; the backend's issuer-uri adds one.
VITE_OIDC_AUTHORITY=https://your-tenant.us.auth0.com

# Client ID of the Auth0 application, which must be of type
# "Single Page Application". Public: it appears in every redirect URL anyway.
VITE_OIDC_CLIENT_ID=your-spa-client-id

# The Identifier of the API registered in Auth0. Must match AUTH0_AUDIENCE on
# the backend exactly. Without it Auth0 returns an opaque token instead of a
# JWT, and the backend cannot read any claims from it.
VITE_OIDC_AUDIENCE=https://api.venuesync.app

# ---------- API ----------
# Leave UNSET for local dev: vite.config.ts proxies /api/* to localhost:8080.
# Set only for deployed builds, via the Cloudflare Pages dashboard.
# VITE_API_BASE_URL=https://venuesync-backend.onrender.com
